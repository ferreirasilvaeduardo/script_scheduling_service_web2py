##############################################################################
#
# trcx       String de conexão Oracle (user/pass@host:port/service)
trcx=openrisow/openrisow@10.238.45.230/svc_gfprodc7
# trscript      Nome do arquivo SQL/PLSQL a ser executado
trscript=exemplo_consulta.sql
# trdirscript   Diretório alternativo para busca do SQL
# trrel      Nome do arquivo de relatório gerado
trrel=TESTE.old
# trdirrel   Diretório de destino da exportação
# trtpex     Tipo de execução: SQL ou PLSQL
# trfertpex  Ferramenta de execução: SQLPLUS (padrão) ou PYTHON
# trdl       Delimitador de colunas (padrão: ;)
trdl=;
# trzip      Compactar saída em ZIP (1 ou S)
trzip=N
# trkp       Manter arquivo original ao compactar (1 ou S)
# trst       Validar tags estritas no SQL (1 ou S)
trst=S
# trnlsl     Idioma NLS da sessão Oracle (padrão: AMERICAN_AMERICA.
trnlsl=AMERICAN_AMERICA.AL32UTF8
# trql       Quantidade de linhas após a qual o arquivo deve ser quebrado
trql=1000

