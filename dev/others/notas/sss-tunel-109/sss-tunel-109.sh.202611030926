#!/bin/bash
# Tunel fixo da clone 7 (10.238.10.109) ate o SSS no 10.129.164.55 em segundo plano (nohup).
# Conexao direta (uma perna) com reconexao automatica caso o link caia.
#
# Uso: ./sss-tunel-109.sh start | stop | status
# Acesso local: http://127.0.0.1:18000/ (DEV) e http://127.0.0.1:18001/ (PROD)
set -u

IP_ESPERADO="10.238.10.109"

_validar_host() {
    # Verifica se o IP esperado esta presente nas interfaces ativas da maquina
    if command -v hostname >/dev/null 2>&1 && hostname -I 2>/dev/null | grep -qw "$IP_ESPERADO"; then
        return 0
    fi
    if command -v ip >/dev/null 2>&1 && ip -4 addr show 2>/dev/null | grep -qw "$IP_ESPERADO"; then
        return 0
    fi
    if command -v ifconfig >/dev/null 2>&1 && ifconfig 2>/dev/null | grep -qw "$IP_ESPERADO"; then
        return 0
    fi

    echo "ERRO: Este script deve ser executado exclusivamente no host $IP_ESPERADO (clone 7)." >&2
    exit 1
}

_validar_host

DESTINO=mastersafgf@10.129.164.55
PORTAS="18000 18001"            # portas locais na clone 7 redirecionadas para as mesmas no destino
DIR=$HOME/.sss_tunel
PID_FILE=$DIR/tunel.pid
LOG=$DIR/tunel.log

SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=30 -o ServerAliveCountMax=3
          -o ExitOnForwardFailure=yes -o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedAlgorithms=+ssh-rsa)

_running() {
    [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

_loop() {
    local local_fwd=() p
    for p in $PORTAS; do
        local_fwd+=(-L "127.0.0.1:$p:127.0.0.1:$p")
    done

    while :; do
        echo "$(date '+%F %T') abrindo o tunel para $DESTINO ($PORTAS)"
        ssh -N "${SSH_OPTS[@]}" "${local_fwd[@]}" "$DESTINO"
        echo "$(date '+%F %T') tunel caiu (codigo $?); nova tentativa em 10 s"
        sleep 10
    done
}

case "${1:-}" in
    start)
        if _running; then echo "ja no ar (pid $(cat "$PID_FILE"))"; exit 0; fi
        mkdir -m 0700 -p "$DIR"
        setsid nohup "$0" _loop >>"$LOG" 2>&1 < /dev/null &
        echo $! > "$PID_FILE"
        sleep 3
        "$0" status
        ;;
    stop)
        if ! _running; then echo "fora do ar"; rm -f "$PID_FILE"; exit 0; fi
        kill -TERM -- "-$(cat "$PID_FILE")" 2>/dev/null
        rm -f "$PID_FILE"
        echo "tunel parado"
        ;;
    status)
        if _running; then 
            echo "laco no ar (pid $(cat "$PID_FILE")); log: $LOG"
        else 
            echo "fora do ar"
        fi
        for p in $PORTAS; do
            curl -s -o /dev/null -m 5 -w "porta $p: HTTP %{http_code}\n" \
                "http://127.0.0.1:$p/script_scheduling_service/default/login" || echo "porta $p: sem resposta"
        done
        ;;
    _loop)
        _loop
        ;;
    *)
        echo "uso: $0 start | stop | status" >&2
        exit 2
        ;;
esac