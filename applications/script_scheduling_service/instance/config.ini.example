[app]
sss_env = DEV                     ; DEV | HML | PROD

[oracle]
user = sss_web                    ; conta do papel deste nó: sss_web no web, sss_agente no agente (README §4.1)
dsn = localhost:2424/servico_homolog
owner = openrisow
table_prefix = tbsss_
modo_driver = auto                ; auto | thin | thick | cx_oracle (README §2.3)
oracle_client_lib_dir =           ; somente macOS (dev); no Linux/Unix usar ldconfig/LD_LIBRARY_PATH
call_timeout_ms = 30000
pool_min = 1
pool_max = 4

[secrets]
secrets_file = /portaloptrib/TESHUVA/web2py/applications/script_scheduling_service/instance

[agent]
agent_id = srv-linux-prod-01
ambientes_atendidos = PRODUCAO,HOMOLOGACAO
work_dir = /portaloptrib/TESHUVA/web2py/applications/script_scheduling_service/work
script_owner_uids = 0             ; UIDs donos dos scripts (README §8.5); recomendado um UID dedicado, sem o 0
interpretadores = PYTHON3=/usr/bin/python3,BASH=/bin/bash,SH=/bin/sh ; executavel local de cada interpretador logico (README §8.5); o agente exige na subida (F8.3)
usuarios_execucao =               ; AMBIENTE=usuario do SO por ambiente (README §8.0); obrigatório fora de DEV, ex.: PRODUCAO=sssprd,HOMOLOGACAO=ssshml
exec_work_dir =                   ; pasta base dos diretórios de trabalho dos scripts (obrigatória fora de DEV), ex.: /portaloptrib/TESHUVA/web2py/applications/script_scheduling_service/exec
max_parallel_jobs = 4
max_parallel_hard_limit = 32
claim_batch_size = 20
schedule_batch_size = 50
orchestrator_interval_s = 10
cancel_poll_interval_s = 2
heartbeat_interval_s = 10
fence_timeout_s = 90
node_offline_timeout_s = 180
kill_grace_s = 5
script_timeout_s = 21600
shutdown_mode = TERMINATE         ; TERMINATE | DRAIN
shutdown_grace_s = 30
misfire_policy = RUN_ONCE         ; RUN_ONCE | SKIP
misfire_tolerance_s = 300
cron_horizon_days = 1461
fila_envelhecimento_min = 60       ; a cada N minutos na fila a prioridade sobe 1 nível (README §5.3); 0 desliga
ambientes_exigem_hash =           ; ex.: PRODUCAO; script sem SHA-256 homologado é recusado nesses ambientes (CR-008, E4)
log_dir_min_livre_mb = 1024       ; abaixo disso em log_dir o agente não reserva tickets (CR-008, R-25)
child_locale = C.UTF-8
env_passthrough = ORACLE_HOME,TNS_ADMIN,NLS_LANG,LD_LIBRARY_PATH

[logging]
log_dir = /portaloptrib/TESHUVA/web2py/applications/script_scheduling_service/logs
level = INFO                      ; DEBUG | INFO | WARN | ERROR
app_log_max_bytes = 10485760
app_log_retention_days = 30
max_log_size_bytes = 5242880
max_local_log_size_bytes = 52428800
local_log_retention_days = 30

[web]
session_idle_timeout_s = 1800
sessao_max_horas = 12   ; vida máxima da sessão desde o login, mesmo com uso contínuo (CR-008, E2)
login_max_tentativas = 5
login_bloqueio_s = 900
log_poll_interval_s = 3
trusted_proxies =
allowed_origins = http://127.0.0.1:18000   ; Ex. https://sss.empresa.local lista separada por vírgula, validada contra Origin/Referer

[retencao]
ticket_retention_days = 180
audit_retention_days = 730
purge_batch_size = 1000
purge_user =                      ; conta Oracle do papel purge, ex.: sss_purge (obrigatória fora de DEV; vazia em DEV = purge desligado)
