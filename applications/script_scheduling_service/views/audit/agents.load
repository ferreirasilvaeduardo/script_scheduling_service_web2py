{{
# Fragmento dos cartões de agentes: resposta de audit/agents.load (atualização automática) e
# incluído por audit/agents.html. O controller aplica os mesmos guardas nas duas extensões.
# Variáveis: painel ({agentes, resumo, agora}), erro.
import ui_helpers
_ag_icones = URL('static', 'img/icons.svg')
}}<div data-sss-fragment="agentes">
  {{if error:}}
  <div class="alert alert-danger mb-0" role="alert">
    <svg class="sss-icon" aria-hidden="true" focusable="false"><use href="{{=_ag_icones}}#icon-alert"></use></svg>
    <span>{{=error}}</span>
  </div>
  {{else:}}
  {{include 'audit/_agent_diagnostics.html'}}
  {{if not dashboard['agents']:}}
  <p class="sss-table-empty mb-0">Nenhum agente registrado.</p>
  {{else:}}
  <p class="sss-text-muted">Referência: {{=ui_helpers.formatar_data(dashboard['now'])}} (relógio do banco).</p>
  <div class="sss-agents">
    {{for _ag in dashboard['agents']:}}
    <article class="sss-agent" aria-labelledby="agent-{{=_ag['code']}}">
      <header class="sss-agent-header">
        <h3 class="sss-agent-title sss-mono" id="agent-{{=_ag['code']}}">{{=_ag['code']}}</h3>
        <span class="sss-status {{=_ag['health']['css_class']}}">
          <svg class="sss-icon" aria-hidden="true" focusable="false"><use href="{{=_ag_icones}}#{{=_ag['health']['icon']}}"></use></svg>
          <span>{{=_ag['health']['label']}}</span>
        </span>
      </header>
      <dl class="sss-summary">
        <dt>Heartbeat</dt><dd>{{=_ag['ago']}}{{if _ag['heartbeat_at']:}} <span class="sss-text-muted">({{=ui_helpers.formatar_data(_ag['heartbeat_at'])}})</span>{{pass}}</dd>
        <dt>Host</dt><dd class="sss-mono">{{=_ag['hostname']}}</dd>
        <dt>Status</dt><dd>{{=_ag['status']}}</dd>
        <dt>Versão</dt><dd>{{=_ag['version'] or '-'}}{{if _ag['platform']:}} · {{=_ag['platform']}}{{pass}}</dd>
        <dt>Ambientes</dt><dd>{{=', '.join(_ag['environments']) or '-'}}</dd>
        <dt>Interpretadores</dt><dd>{{=', '.join(_ag['interpreters']) or '-'}}</dd>
        <dt>Iniciado em</dt><dd>{{=ui_helpers.formatar_data(_ag['started_at'])}}</dd>
      </dl>
      <details class="sss-agent-tickets" data-agent="{{=_ag['code']}}">
        <summary>Tickets em execução: <strong>{{=_ag['running']}}</strong></summary>
        {{if _ag['tickets']:}}
        <ul class="sss-agent-list">
          {{for _t in _ag['tickets']:}}
          <li>
            <a href="{{=URL(c='tickets', f='detail', args=[_t['id']], extension=False)}}">#{{=_t['id']}}</a>
            <span class="sss-mono">{{=_t['script_name']}}</span> · {{=_t['environment']}} · {{=_t['requested_by']}}
            <span class="sss-text-muted">· em execução há {{=_t['duration']}} · heartbeat {{=_t['heartbeat']}}</span>
          </li>
          {{pass}}
        </ul>
        {{else:}}
        <p class="sss-text-muted mb-0">Nenhum ticket em execução neste agente.</p>
        {{pass}}
      </details>
    </article>
    {{pass}}
  </div>
  {{pass}}
  {{pass}}
</div>
