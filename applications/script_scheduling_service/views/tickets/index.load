{{
# Fragmento da tabela de tickets: resposta de tickets/index.load (atualização automática) e
# incluído por tickets/index.html. O controller aplica os mesmos guardas nas duas extensões.
# Variáveis: result, error, page, size, query_params.
import ui_helpers
_lt_items = result['items']
_lt_ncol = 10
total = result['total']
total_capped = result.get('total_capped', False)
page_count = len(result['items'])
url_base = ('tickets', 'index')
}}<div data-sss-fragment="tickets">
  <div class="table-responsive">
    <table class="table table-sm sss-table mb-0">
      <caption class="visually-hidden">Tickets{{if error:}} (erro ao carregar){{pass}}</caption>
      <thead>
        <tr>
          <th scope="col" class="sss-col-num">#</th>
          <th scope="col">Script</th>
          <th scope="col">Ambiente</th>
          <th scope="col">Situação</th>
          <th scope="col" class="sss-col-num">Prioridade</th>
          <th scope="col">Solicitante</th>
          <th scope="col" class="sss-col-data">Criado em</th>
          <th scope="col" class="sss-col-data">Início</th>
          <th scope="col" class="sss-col-num">Duração</th>
          <th scope="col"><span class="visually-hidden">Ações</span></th>
        </tr>
      </thead>
      <tbody>
        {{if error:}}
        <tr>
          <td colspan="{{=_lt_ncol}}" class="sss-table-state">
            <div class="alert alert-danger mb-0" role="alert">
              <svg class="sss-icon" aria-hidden="true" focusable="false"><use href="{{=URL('static', 'img/icons.svg')}}#icon-alert"></use></svg>
              <span>{{=error}}</span>
            </div>
          </td>
        </tr>
        {{elif not _lt_items:}}
        <tr>
          <td colspan="{{=_lt_ncol}}" class="sss-table-state sss-table-empty">Nenhum ticket encontrado para os filtros informados.</td>
        </tr>
        {{else:}}
        {{for _lt in _lt_items:}}
        <tr{{if _lt['status'] == 'RUNNING':}} class="sss-row-running"{{pass}}>
          <td class="sss-col-num sss-mono"><a href="{{=URL(c='tickets', f='detail', args=[_lt['id']], extension=False)}}">{{=_lt['id']}}</a></td>
          <td class="sss-mono">{{=_lt['script_name']}}{{if _lt['source'] == 'agendamento':}} <span class="badge text-bg-secondary" title="Criado por regra de agendamento">agend.</span>{{pass}}</td>
          <td>{{=_lt['environment']}}</td>
          <td>
            {{status = _lt['status']
            status_reason = None}}<span{{if _lt['reason_description']:}} title="{{=_lt['reason_description']}}"{{pass}}>{{include 'components/badge_status.html'}}</span>
            {{if _lt['reason_name']:}}<span class="sss-reason">{{=_lt['reason_name']}}</span>{{pass}}
            {{if _lt['cancel_requested'] and _lt['status'] == 'RUNNING':}}<span class="sss-reason">Cancelamento solicitado</span>{{pass}}
          </td>
          <td class="sss-col-num">{{=_lt['priority']}}</td>
          <td>{{=_lt['requested_by']}}</td>
          <td class="sss-col-data">{{=ui_helpers.format_date(_lt['created_at'])}}</td>
          <td class="sss-col-data">{{=ui_helpers.format_date(_lt['started_at'])}}</td>
          <td class="sss-col-num">{{=_lt['duration']}}</td>
          <td><a class="btn btn-sm btn-outline-secondary" href="{{=URL(c='tickets', f='detail', args=[_lt['id']], extension=False)}}" aria-label="Detalhes do ticket {{=_lt['id']}}">Detalhes</a></td>
        </tr>
        {{pass}}
        {{pass}}
      </tbody>
    </table>
  </div>
  {{include 'components/pagination.html'}}
</div>
