; secrets.cfg do NO WEB (CR-028): copie para instance/web0001/secrets.cfg, dono = usuario do processo, modo 0600.
; So [oracle] e [web] (README §4.1). Nunca versione o arquivo real.
[oracle]
password = CHANGE_ME           ; conta Oracle do papel web ([oracle] user)

[web]
cookie_key = CHANGE_ME         ; igual em todos os nos web; gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
