; config.ini do NO WEB (CR-028): copie para instance/web0001/config.ini (o nome da pasta e o do processo).
; So [app] e [web]: o web nao tem [agent] (README §12.1). As pastas saem de var/web0001/.
; O banco ([oracle]) fica no instance/common.ini do servidor (modelo: instance/exemplos/common.ini.example).
; Os segredos ficam no instance/secrets.cfg unico do servidor (modelo: instance/exemplos/secrets.cfg.example).
; Suba com: bin/sss-web.sh web0001 --host 127.0.0.1 --port 8000
;
; DEV e PROD sao iguais (CR-032): o ambiente mostrado vem da pasta acima da raiz (DEV ou PROD).
; UM USUARIO SO (sem root; DEPLOYMENT §4.0): no common.ini, [oracle] user = a conta unica (dona do esquema);
; suba pelo bin/sss-keepalive.sh web0001:<porta> no cron (§10.6).

[app]
name = web0001                    ; nome do processo: o mesmo da pasta instance/web0001/

[web]
allowed_origins = http://sss.empresa.local:8000   ; a URL que o usuario digita (http ou https)
; trusted_proxies = 127.0.0.1    ; com proxy na frente
