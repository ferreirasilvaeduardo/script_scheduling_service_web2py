; config.ini do AGENTE (CR-028): copie para instance/agente0001/config.ini (o nome da pasta e o do processo).
; Sem [web] (README §12.1). O agent_id e o proprio nome, unico em toda a instalacao. As pastas saem de
; var/agente0001/ (logs, works, outputs, inputs, script_works, files) e scripts_ambiente/, criadas na subida.
; Os segredos ficam no instance/secrets.cfg unico do servidor (modelo: instance/exemplos/secrets.cfg.example).
; O banco ([oracle]) fica no instance/common.ini do servidor (modelo: instance/exemplos/common.ini.example).
; Suba com: bin/sss-scheduler.sh agente0001
;
; DEV e PROD sao iguais (CR-032): o ambiente mostrado vem da pasta acima da raiz (DEV ou PROD).
; UM USUARIO SO (sem root; DEPLOYMENT §4.0): no common.ini, [oracle] user = a conta unica (dona do esquema);
; suba pelo bin/sss-keepalive.sh agente0001 no cron (§10.6).

[app]
name = agente0001                 ; nome do processo e agent_id

[agent]
environments = PRODUCAO           ; ambientes que este agente atende
max_parallel_jobs = 4
env_passthrough = ORACLE_HOME,TNS_ADMIN,NLS_LANG,LD_LIBRARY_PATH
; output_dir =                    ; escrito vazio desliga a tela de Saidas (o padrao e var/agente0001/outputs)
