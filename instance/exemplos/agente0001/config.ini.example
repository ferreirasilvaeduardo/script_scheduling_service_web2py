; config.ini do AGENTE (CR-028): copie para instance/agente0001/config.ini (o nome da pasta e o do processo).
; Sem [web] (README §12.1). O agent_id e o proprio nome, unico em toda a instalacao. As pastas saem de
; var/agente0001/ (logs, work, output, input, script_work), var/exec/ e scripts_ambiente/, criadas na subida.
; Os segredos ficam no instance/secrets.cfg unico do servidor (modelo: instance/exemplos/secrets.cfg.example).
; Suba com: bin/sss-scheduler.sh agente0001
;
; UM USUARIO SO (sem root; DEPLOYMENT §4.0): sss_env = DEV; [oracle] user = a conta unica (dona do esquema);
; apague exec_users; suba pelo bin/sss-keepalive.sh agente0001 no cron (§10.6).

[app]
sss_env = PROD                    ; DEV | HML | PROD
name = agente0001                 ; nome do processo e agent_id

[oracle]
user = sss_agente                 ; conta do papel agente (README §4.1), nunca a dona do esquema
dsn = servidor-banco:1521/servico
owner = openrisow
table_prefix = tbsss_
driver_mode = thick

[agent]
environments = PRODUCAO           ; ambientes que este agente atende
max_parallel_jobs = 4
exec_users = PRODUCAO=sssprd      ; usuario do SO por ambiente (obrigatorio fora de DEV)
env_passthrough = ORACLE_HOME,TNS_ADMIN,NLS_LANG,LD_LIBRARY_PATH
; helper_path = ...               ; padrao: ../sss-root/bin/sss-helper, ao lado da raiz (pasta so do root)
; output_dir =                    ; escrito vazio desliga a tela de Saidas (o padrao e var/agente0001/output)
