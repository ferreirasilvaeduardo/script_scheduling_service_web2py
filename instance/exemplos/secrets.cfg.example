; secrets.cfg UNICO do servidor (CR-032, D14): copie para instance/secrets.cfg, dono = a conta do SSS, modo 0600.
; Todos os processos do servidor leem este arquivo; cada um usa so o que precisa. Nunca versione o arquivo real.
[oracle]
password = CHANGE_ME           ; senha da conta do [oracle] user (a mesma em todos os processos)

[web]
cookie_key = CHANGE_ME         ; so o web usa; igual em todos os nos web; gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

[environment:PRODUCAO]         ; so os agentes usam; um bloco por ambiente atendido (bancos dos scripts)
user = CHANGE_ME
password = CHANGE_ME
