#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""sss-helper: unica forma de o agente do SSS agir como o usuario de execucao (README §8.0; CR-007, D1).

Instalado pelo root em /opt/sss/bin/sss-helper (dono root, 0755, pasta so do root) e chamado so por
"sudo -n -u <usuario de execucao> -- /opt/sss/bin/sss-helper <subcomando>". Python 3.6, so biblioteca
padrao, sem importar a aplicacao nem ler o config.ini. Valida os proprios argumentos.

Subcomandos:
  run                                         especificacao JSON pela entrada padrao; execve do script
  term <pgid> <process_start>                 SIGTERM ao grupo (identidade do lider conferida)
  kill <pgid> <process_start>                 SIGKILL ao grupo (idem)
  clean <base_dir> <ticket_id>                remove <base_dir>/ticket_<id>/ sem seguir links
  stop-ticket <base_dir> <ticket_id> <kill_grace_s>
                                              encerra os processos do usuario cujo cwd esta na pasta do ticket
  pack <base> <relativo> <max_bytes> <max_arquivos>
                                              zip da pasta de saida do ticket na saida padrao (CR-012)
  clean-output <base> <relativo>              remove a pasta de saida do ticket sem seguir links (CR-012)
  purge-output <base> <dias> [count]          remove as pastas de minuto de saida mais antigas que <dias>
                                              (com "count", so conta: --dry-run do purge)

Codigos de saida: 0 sucesso, 2 uso invalido, 3 recusado (identidade divergente), 4 erro do sistema,
5 nao suportado nesta plataforma, 6 pasta de saida vazia ou inexistente, 7 saida acima do limite de
arquivos, 8 saida acima do limite de bytes (pack). Mensagens so no stderr, sem valores sensiveis.

Excecao estreita do AGENTS §3.2: limites de recurso so em _run, sinal a grupo so em _term/_kill, leitura do
stat do processo so em _identity, e consulta do cwd dos processos so em _stop_ticket.
"""
import datetime
import json
import os
import re
import resource
import signal
import shutil
import stat
import subprocess
import sys
import time
import zipfile

INVALID_USAGE = 2
REFUSED = 3
SYSTEM_ERROR = 4
UNSUPPORTED = 5
OUTPUT_EMPTY = 6
OUTPUT_TOO_MANY_FILES = 7
OUTPUT_TOO_MANY_BYTES = 8

# Pasta de saida (CR-012, README §8.13): base = output_dir/<ambiente>; relativo = pasta do script (forma
# segura de pastas_log.pasta_script), AAAA/MM/DD/HH/MI e ticket_<id>.
_RE_SCRIPT_DIR = re.compile(r"^[a-z0-9-][a-z0-9._-]{0,199}$")
_RE_MINUTE_RELATIVE = re.compile(r"^\d{4}/\d{2}/\d{2}/\d{2}/\d{2}$")
_RE_TICKET = re.compile(r"^ticket_[1-9]\d{0,9}$")
_CHUNK = 64 * 1024
_MAX_OUTPUT_BYTES = 209715200
_MAX_OUTPUT_FILES = 10000
_MTIME_MIN = 315705600  # 1980-01-03 UTC: o zip nao aceita datas anteriores a 1980 em nenhum fuso

_MAX_SPEC = 1024 * 1024
_ALLOWED_RLIMITS = ("RLIMIT_CORE", "RLIMIT_NOFILE", "RLIMIT_CPU", "RLIMIT_AS", "RLIMIT_FSIZE",
                       "RLIMIT_NPROC", "RLIMIT_DATA", "RLIMIT_STACK")


class Failure(Exception):
    def __init__(self, code, message):
        Exception.__init__(self, message)
        self.code = code


def _error(code, message):
    raise Failure(code, message)


def _integer(text, name, minimum=0, maximum=None):
    if not isinstance(text, str) or not text.isdigit():
        _error(INVALID_USAGE, "%s invalido" % name)
    valor = int(text)
    if valor < minimum or (maximum is not None and valor > maximum):
        _error(INVALID_USAGE, "%s fora da faixa" % name)
    return valor


def _base_dir(path, name="base_dir"):
    """exec_work_dir/<usuario> ou output_dir/<ambiente>: absoluta, normalizada, sem link e do proprio usuario
    (CR-008, R-36; CR-012)."""
    if not isinstance(path, str) or not path.startswith("/") or os.path.normpath(path) != path:
        _error(INVALID_USAGE, "%s deve ser absoluta e normalizada" % name)
    if os.path.realpath(path) != path:
        _error(INVALID_USAGE, "%s nao pode ter link simbolico" % name)
    try:
        st = os.lstat(path)
    except OSError:
        _error(INVALID_USAGE, "%s inexistente" % name)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
        _error(INVALID_USAGE, "%s deve ser um diretorio do proprio usuario" % name)
    return path


def _relative_parts(relative):
    """<pasta do script>/AAAA/MM/DD/HH/MI/ticket_<id> com exatamente esse formato (CR-012)."""
    if not isinstance(relative, str):
        _error(INVALID_USAGE, "relativo invalido")
    partes = relative.split("/")
    if len(partes) != 7 or not _RE_SCRIPT_DIR.match(partes[0]) \
            or not _RE_MINUTE_RELATIVE.match("/".join(partes[1:6])) or not _RE_TICKET.match(partes[6]):
        _error(INVALID_USAGE, "relativo fora do formato <script>/AAAA/MM/DD/HH/MI/ticket_<id>")
    return partes


def _own_directory(path):
    """True se caminho e diretorio do proprio usuario (sem seguir link); False se nao existe."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return False
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
        _error(INVALID_USAGE, "item do caminho da saida nao e diretorio do proprio usuario")
    return True


def _output_dir(base, relative, create=False):
    """Pasta de saida do ticket, conferida nivel a nivel sem seguir links; criar=True cria com 0700.

    Devolve o caminho, ou None se algum nivel nao existir (e criar=False).
    """
    atual = _base_dir(base, "base")
    for parte in _relative_parts(relative):
        atual = os.path.join(atual, parte)
        if _own_directory(atual):
            continue
        if not create:
            return None
        try:
            os.mkdir(atual, 0o700)
        except FileExistsError:  # criado por outro caminho entre o lstat e o mkdir: conferido abaixo
            pass
        if not _own_directory(atual):
            _error(SYSTEM_ERROR, "pasta de saida nao foi criada")
        os.chmod(atual, 0o700)
    return atual


def _input_dir(base, relative):
    """Pasta de entrada do script (CR-014, README §8.14): base = input_dir/<ambiente> e relativo = a pasta do
    script, um nivel so. Permanente: criada com 0700 se nao existir, sem seguir link; a existente fica como esta."""
    if not isinstance(relative, str) or not _RE_SCRIPT_DIR.match(relative):
        _error(INVALID_USAGE, "entrada fora do formato <script>")
    atual = os.path.join(_base_dir(base, "base"), relative)
    if not _own_directory(atual):
        try:
            os.mkdir(atual, 0o700)
        except FileExistsError:  # criada por outro ticket entre o lstat e o mkdir: conferida abaixo
            pass
        if not _own_directory(atual):
            _error(SYSTEM_ERROR, "pasta de entrada nao foi criada")
    return atual


def _ticket_dir(base_dir, ticket_id):
    return os.path.join(base_dir, "ticket_%d" % ticket_id)


# -----------------------------------------------------------------------------
# run
# -----------------------------------------------------------------------------

def _read_spec(input_value):
    bruto = input_value.read(_MAX_SPEC + 1)
    if len(bruto) > _MAX_SPEC:
        _error(INVALID_USAGE, "especificacao maior que 1 MiB")
    try:
        spec = json.loads(bruto.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        _error(INVALID_USAGE, "especificacao nao e JSON valido")
    if not isinstance(spec, dict):
        _error(INVALID_USAGE, "especificacao deve ser um objeto")
    ticket_id = spec.get("ticket_id")
    if not isinstance(ticket_id, int) or isinstance(ticket_id, bool) or ticket_id < 1:
        _error(INVALID_USAGE, "ticket_id invalido")
    argv = spec.get("argv")
    if not isinstance(argv, list) or not argv or not all(isinstance(a, str) for a in argv):
        _error(INVALID_USAGE, "argv invalido")
    if not argv[0].startswith("/"):
        _error(INVALID_USAGE, "argv[0] deve ser absoluto")
    env = spec.get("env") or {}
    if not isinstance(env, dict) or not all(isinstance(k, str) and isinstance(v, str) for k, v in env.items()):
        _error(INVALID_USAGE, "env invalido")
    rlimits = spec.get("rlimits") or {}
    if not isinstance(rlimits, dict):
        _error(INVALID_USAGE, "rlimits invalido")
    limites = {"RLIMIT_CORE": (0, 0), "RLIMIT_NOFILE": (1024, 1024)}
    for nome, valor in rlimits.items():
        if nome not in _ALLOWED_RLIMITS or not isinstance(valor, list) or len(valor) != 2 \
                or not all(isinstance(x, int) and not isinstance(x, bool) for x in valor):
            _error(INVALID_USAGE, "limite de recurso invalido")
        limites[nome] = (valor[0], valor[1])
    saida = spec.get("output")
    if saida is not None:
        if not isinstance(saida, dict) or set(saida) != {"base", "relativo"}:
            _error(INVALID_USAGE, "saida invalida")
        _base_dir(saida["base"], "base")
        if _relative_parts(saida["relativo"])[6] != "ticket_%d" % ticket_id:
            _error(INVALID_USAGE, "saida de outro ticket")
    input_value = spec.get("input")
    if input_value is not None:
        if not isinstance(input_value, dict) or set(input_value) != {"base", "relativo"}:
            _error(INVALID_USAGE, "entrada invalida")
        _base_dir(input_value["base"], "base")
        if not isinstance(input_value["relativo"], str) or not _RE_SCRIPT_DIR.match(input_value["relativo"]):
            _error(INVALID_USAGE, "entrada fora do formato <script>")
    return ticket_id, argv, env, limites, _base_dir(spec.get("base_dir")), saida, input_value


def _run(input_value=None, run=os.execve):
    """Cria <pasta_base>/ticket_<id>/ e tmp/ (0700), entra nela, aplica umask e limites e faz execve."""
    ticket_id, argv, env, limites, pasta_base, saida, pasta_entrada = _read_spec(
        input_value or sys.stdin.buffer)
    pasta = _ticket_dir(pasta_base, ticket_id)
    try:
        # O script nunca le a entrada padrao do helper (a especificacao ja foi consumida).
        nulo = os.open(os.devnull, os.O_RDONLY)
        os.dup2(nulo, 0)
        os.close(nulo)
        os.makedirs(os.path.join(pasta, "tmp"), mode=0o700, exist_ok=True)
        os.chmod(pasta, 0o700)
        os.chmod(os.path.join(pasta, "tmp"), 0o700)
        if saida is not None:
            # CR-012: a pasta de saida do ticket, do usuario de execucao, antes do script (README §8.13).
            _output_dir(saida["base"], saida["relativo"], create=True)
        if pasta_entrada is not None:
            # CR-014: a pasta de entrada do script, permanente, do usuario de execucao (README §8.14).
            _input_dir(pasta_entrada["base"], pasta_entrada["relativo"])
        os.chdir(pasta)
        os.umask(0o077)
        for nome, par in sorted(limites.items()):
            resource.setrlimit(getattr(resource, nome), par)
    except OSError as e:
        _error(SYSTEM_ERROR, "preparo da execucao falhou (%s)" % e.__class__.__name__)
    try:
        run(argv[0], argv, env)
    except OSError as e:
        _error(SYSTEM_ERROR, "execve falhou (%s)" % e.__class__.__name__)
    return 0


# -----------------------------------------------------------------------------
# term / kill
# -----------------------------------------------------------------------------

def _identity(pid):
    """starttime do processo (campo 22 de /proc/<pid>/stat, depois do ultimo ')'); None se ilegivel."""
    try:
        with open("/proc/%d/stat" % pid, "r") as f:
            conteudo = f.read()
        return int(conteudo[conteudo.rindex(")") + 2:].split()[19])
    except (OSError, ValueError, IndexError):  # processo saiu ou /proc ilegivel: identidade desconhecida
        return None


def _signal(pgid, process_start, signal_value):
    if pgid <= 1:
        _error(INVALID_USAGE, "pgid invalido")
    try:
        os.kill(pgid, 0)
        lider_vivo = True
    except ProcessLookupError:  # lider ja saiu; os membros do grupo seguem (R-02)
        lider_vivo = False
    except PermissionError:
        # O lider do grupo e o sudo, que roda como root: EPERM e o caso normal. A identidade lida em
        # /proc/<pid>/stat (legivel por todos) protege contra PID reciclado (revisao de 2026-10-20).
        lider_vivo = True
    if lider_vivo:
        identidade = _identity(pgid)
        if identidade is None or identidade != process_start:
            _error(REFUSED, "identidade do lider diverge (PID reciclado)")
    return signal_value


def _term(pgid, process_start):
    sinal = _signal(pgid, process_start, signal.SIGTERM)
    try:
        os.killpg(pgid, sinal)
    except ProcessLookupError:  # ESRCH = grupo vazio: sucesso
        return 0
    except PermissionError:  # so o sudo (root) resta no grupo: nada do usuario de execucao a sinalizar
        return 0
    return 0


def _kill(pgid, process_start):
    sinal = _signal(pgid, process_start, signal.SIGKILL)
    try:
        os.killpg(pgid, sinal)
    except ProcessLookupError:  # ESRCH = grupo vazio: sucesso
        return 0
    except PermissionError:  # so o sudo (root) resta no grupo: nada do usuario de execucao a sinalizar
        return 0
    return 0


# -----------------------------------------------------------------------------
# limpar / stop-ticket
# -----------------------------------------------------------------------------

def _clean(base_dir, ticket_id):
    """Remove <pasta_base>/ticket_<id>/ sem seguir links simbolicos."""
    pasta = _ticket_dir(_base_dir(base_dir), ticket_id)
    if not os.path.lexists(pasta):
        return 0
    if os.path.islink(pasta) or not os.path.isdir(pasta):
        _error(INVALID_USAGE, "pasta do ticket nao e um diretorio")
    try:
        shutil.rmtree(pasta)  # rmtree nao segue links simbolicos internos (remove o proprio link)
    except OSError as e:
        _error(SYSTEM_ERROR, "limpeza falhou (%s)" % e.__class__.__name__)
    return 0


def _stop_ticket(base_dir, ticket_id, kill_grace_s, list_fn=None):
    """SIGTERM e, depois de kill_grace_s, SIGKILL aos processos do proprio usuario cujo cwd esta na pasta do
    ticket (Linux: /proc/<pid>/cwd; outros Unix: pwdx). Sem meio de identificar: codigo 5."""
    pasta = _ticket_dir(_base_dir(base_dir), ticket_id)
    meu_uid = os.geteuid()
    pwdx = [p for p in ("/usr/bin/pwdx", "/bin/pwdx") if os.path.isfile(p)]

    def _na_pasta(cwd):
        cwd = os.path.normpath(cwd)
        return os.path.commonpath([cwd, pasta]) == pasta

    def _listar_proc():
        pids = []
        for nome in os.listdir("/proc/"):
            if not nome.isdigit() or int(nome) == os.getpid():
                continue
            try:
                if os.stat("/proc/" + nome).st_uid != meu_uid:
                    continue
                if _na_pasta(os.readlink("/proc/%s/cwd" % nome)):
                    pids.append(int(nome))
            except OSError:  # processo saiu durante a varredura
                continue
        return pids

    def _listar_pwdx():
        saida = subprocess.run(["/bin/ps", "-U", str(meu_uid), "-o", "pid="], stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, universal_newlines=True).stdout
        pids = []
        for pid in (int(x) for x in saida.split() if x.isdigit()):
            linha = subprocess.run([pwdx[0], str(pid)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                   universal_newlines=True).stdout
            partes = linha.split(":", 1)
            if len(partes) == 2 and _na_pasta(partes[1].strip()):
                pids.append(pid)
        return pids

    if list_fn is None:
        if os.path.isdir("/proc/self") and os.path.exists("/proc/self/cwd"):
            list_fn = _listar_proc
        elif pwdx:
            list_fn = _listar_pwdx
        else:
            _error(UNSUPPORTED, "sem /proc/<pid>/cwd nem pwdx nesta plataforma")

    for sinal in (signal.SIGTERM, signal.SIGKILL):
        pids = list_fn()
        for pid in pids:
            try:
                os.kill(pid, sinal)
            except ProcessLookupError:  # processo ja saiu
                pass
        if not pids or sinal == signal.SIGKILL:
            break
        limite = time.monotonic() + kill_grace_s
        while time.monotonic() < limite and list_fn():
            time.sleep(0.1)
    return 0


# -----------------------------------------------------------------------------
# Pasta de saida (CR-012)
# -----------------------------------------------------------------------------

class _CountedOutput(object):
    """Saida padrao sem seek. Ao passar de max_bytes, marca excedeu e descarta o resto: o laco para e o zip
    fecha normalmente (o zipfile da 3.6 nao fecha com um handle de escrita aberto apos erro)."""

    def __init__(self, destination, max_bytes):
        self.destination = destination
        self.max_bytes = max_bytes
        self.written = 0
        self.exceeded = False

    def write(self, date):
        if not self.exceeded:
            self.written += len(date)
            if self.written > self.max_bytes:
                self.exceeded = True
            else:
                self.destination.write(date)
        return len(date)

    def flush(self):
        self.destination.flush()


def _output_files(folder, max_files):
    """[(caminho, nome_relativo)] dos arquivos regulares, sem seguir links; acima do limite: codigo 7."""
    arquivos = []
    for raiz, dirs, nomes in os.walk(folder, followlinks=False):
        dirs.sort()
        for nome in sorted(nomes):
            caminho = os.path.join(raiz, nome)
            try:
                if not stat.S_ISREG(os.lstat(caminho).st_mode):
                    continue  # link, socket, fifo ou dispositivo: fora do zip
            except OSError:  # o script apagou o arquivo durante a varredura
                continue
            arquivos.append((caminho, os.path.relpath(caminho, folder)))
            if len(arquivos) > max_files:
                _error(OUTPUT_TOO_MANY_FILES, "saida acima do limite de arquivos")
    return arquivos


def _pack(base, relative, max_bytes, max_files, destination=None):
    """Zip (ZIP_DEFLATED) da pasta de saida na saida padrao. Vazia: 6; arquivos: 7; bytes: 8."""
    pasta = _output_dir(base, relative)
    if pasta is None:
        _error(OUTPUT_EMPTY, "pasta de saida inexistente")
    arquivos = _output_files(pasta, max_files)
    if not arquivos:
        _error(OUTPUT_EMPTY, "pasta de saida vazia")
    saida = _CountedOutput(destination or sys.stdout.buffer, max_bytes)
    try:
        with zipfile.ZipFile(saida, "w", zipfile.ZIP_DEFLATED) as z:
            for caminho, nome in arquivos:
                try:
                    fd = os.open(caminho, os.O_RDONLY | os.O_NOFOLLOW)
                except OSError:  # apagado ou trocado por link depois da varredura: fica de fora
                    continue
                with os.fdopen(fd, "rb") as f:
                    st = os.fstat(f.fileno())
                    if not stat.S_ISREG(st.st_mode):
                        continue
                    info = zipfile.ZipInfo(nome, time.localtime(max(st.st_mtime, _MTIME_MIN))[:6])
                    info.compress_type = zipfile.ZIP_DEFLATED
                    info.external_attr = 0o600 << 16
                    with z.open(info, "w") as dst:
                        while not saida.exceeded:
                            bloco = f.read(_CHUNK)
                            if not bloco:
                                break
                            dst.write(bloco)
                if saida.exceeded:
                    break
        saida.flush()
    except OSError as e:
        _error(SYSTEM_ERROR, "empacotamento falhou (%s)" % e.__class__.__name__)
    if saida.exceeded:
        _error(OUTPUT_TOO_MANY_BYTES, "saida acima do limite de bytes")
    return 0


def _clean_output(base, relative):
    """Remove a pasta de saida do ticket sem seguir links simbolicos (as pastas acima ficam para o purge)."""
    pasta = _output_dir(base, relative)
    if pasta is None:
        return 0
    try:
        shutil.rmtree(pasta)  # rmtree nao segue links simbolicos internos (remove o proprio link)
    except OSError as e:
        _error(SYSTEM_ERROR, "limpeza da saida falhou (%s)" % e.__class__.__name__)
    return 0


def _purge_output(base, days, today=None, count_only=False):
    """Remove <base>/<script>/AAAA/MM/DD/HH/MI anteriores a hoje - dias (data tirada do caminho) e as pastas
    que ficarem vazias acima delas. Imprime 'removidas=<n>'. Itens fora do formato sao ignorados.
    contar=True so conta (nada e removido)."""
    base = _base_dir(base, "base")
    limite = (today or datetime.date.today()) - datetime.timedelta(days=days)
    removidas = 0

    def _subpastas(folder, regex):
        try:
            nomes = sorted(os.listdir(folder))
        except OSError:  # pasta removida durante a varredura
            return []
        return [os.path.join(folder, n) for n in nomes
                if regex.match(n) and _own_directory(os.path.join(folder, n))]

    def _remover_se_vazia(folder):
        try:
            os.rmdir(folder)
        except OSError:  # nao vazia (ou ja removida): fica
            pass

    ano, dois = re.compile(r"^\d{4}$"), re.compile(r"^\d{2}$")
    for p_scr in _subpastas(base, _RE_SCRIPT_DIR):
        for p_ano in _subpastas(p_scr, ano):
            for p_mes in _subpastas(p_ano, dois):
                for p_dia in _subpastas(p_mes, dois):
                    a, m, d = (int(os.path.basename(x)) for x in (p_ano, p_mes, p_dia))
                    try:
                        data = datetime.date(a, m, d)
                    except ValueError:  # data invalida no caminho: fora do formato
                        continue
                    if data < limite:
                        for p_hora in _subpastas(p_dia, dois):
                            for p_min in _subpastas(p_hora, dois):
                                if count_only:
                                    removidas += 1
                                    continue
                                try:
                                    shutil.rmtree(p_min)
                                    removidas += 1
                                except OSError as e:
                                    _error(SYSTEM_ERROR, "purga da saida falhou (%s)" % e.__class__.__name__)
                            if not count_only:
                                _remover_se_vazia(p_hora)
                    if not count_only:
                        _remover_se_vazia(p_dia)
                if not count_only:
                    _remover_se_vazia(p_mes)
            if not count_only:
                _remover_se_vazia(p_ano)
        if not count_only:
            _remover_se_vazia(p_scr)
    sys.stdout.write("removidas=%d\n" % removidas)
    return 0


# -----------------------------------------------------------------------------
# Entrada
# -----------------------------------------------------------------------------

def run_main(argv):
    if not argv:
        _error(INVALID_USAGE, "subcomando ausente")
    sub, args = argv[0], argv[1:]
    if sub == "run" and not args:
        return _run()
    if sub in ("term", "kill") and len(args) == 2:
        pgid = _integer(args[0], "pgid", minimum=2)
        inicio = _integer(args[1], "process_start")
        return _term(pgid, inicio) if sub == "term" else _kill(pgid, inicio)
    if sub == "clean" and len(args) == 2:
        return _clean(args[0], _integer(args[1], "ticket_id", minimum=1))
    if sub == "pack" and len(args) == 4:
        return _pack(args[0], args[1], _integer(args[2], "max_bytes", minimum=1, maximum=_MAX_OUTPUT_BYTES),
                          _integer(args[3], "max_arquivos", minimum=1, maximum=_MAX_OUTPUT_FILES))
    if sub == "clean-output" and len(args) == 2:
        return _clean_output(args[0], args[1])
    if sub == "purge-output" and (len(args) == 2 or (len(args) == 3 and args[2] == "count")):
        return _purge_output(args[0], _integer(args[1], "dias", minimum=1, maximum=3650), count_only=len(args) == 3)
    if sub == "stop-ticket" and len(args) == 3:
        return _stop_ticket(args[0], _integer(args[1], "ticket_id", minimum=1),
                                _integer(args[2], "kill_grace_s", maximum=300))
    _error(INVALID_USAGE, "uso invalido")


def main():
    try:
        return run_main(sys.argv[1:])
    except Failure as f:
        sys.stderr.write("sss-helper: %s\n" % f)
        return f.code
    except Exception as e:  # noqa: BLE001 - nenhum traceback com dados sai do helper
        sys.stderr.write("sss-helper: erro inesperado (%s)\n" % e.__class__.__name__)
        return SYSTEM_ERROR


if __name__ == "__main__":
    sys.exit(main())
