#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""sss-helper: unica forma de o agente do SSS agir como o usuario de execucao (README §8.0; CR-007, D1).

Instalado pelo root no [agent] helper_path (CR-028; padrao /portaloptrib/TESHUVA/SSS/<TIPO>/sss-root/bin/
sss-helper, fora da raiz; dono root, 0755, pasta so do root) e chamado so por
"sudo -n -u <usuario de execucao> -- <helper_path> <subcomando>". Python 3.6, so biblioteca
padrao, sem importar a aplicacao nem ler o config.ini. Valida os proprios argumentos.

Subcomandos:
  run                                         especificacao JSON pela entrada padrao; execve do script
                                              (cria as pastas de saida, de entrada e de trabalho pedidas)
  term <pgid> <process_start>                 SIGTERM ao grupo (identidade do lider conferida)
  kill <pgid> <process_start>                 SIGKILL ao grupo (idem)
  clean <base_dir> <ticket_id>                remove <base_dir>/ticket_<id>/ sem seguir links
  stop-ticket <base_dir> <ticket_id> <kill_grace_s>
                                              encerra os processos do usuario cujo cwd esta na pasta do ticket
  pack <base> <relativo> <max_bytes> <max_arquivos>
                                              zip da pasta de saida do ticket na saida padrao (CR-012)
  clean-output <base> <relativo>              remove a pasta de saida do ticket sem seguir links (CR-012)
  put-input <base> <script> <subpasta|-> <nome> <Y|N> <sha256> <bytes>
                                              grava o arquivo da entrada padrao na pasta de entrada do
                                              script (CR-020c): temporario no destino, hash conferido e
                                              publicacao atomica (sem substituir: link; substituindo: replace)
  list-input <base> <script> <max_itens>      retrato JSON da pasta de entrada do script, sem seguir links

Codigos de saida: 0 sucesso, 2 uso invalido, 3 recusado (identidade divergente), 4 erro do sistema,
5 nao suportado nesta plataforma, 6 pasta de saida vazia ou inexistente, 7 saida acima do limite de
arquivos, 8 saida acima do limite de bytes (pack), 9 arquivo ja existe, 10 sem espaco, 11 hash ou tamanho
divergente (put-input). Mensagens so no stderr, sem valores sensiveis.

Excecao estreita do AGENTS §3.2: limites de recurso so em _run, sinal a grupo so em _term/_kill, leitura do
stat do processo so em _identity, e consulta do cwd dos processos so em _stop_ticket.
"""
import datetime
import errno
import hashlib
import json
import os
import re
import resource
import signal
import shutil
import stat
import subprocess
import sys
import time
import zipfile

INVALID_USAGE = 2
REFUSED = 3
SYSTEM_ERROR = 4
UNSUPPORTED = 5
OUTPUT_EMPTY = 6
OUTPUT_TOO_MANY_FILES = 7
OUTPUT_TOO_MANY_BYTES = 8
INPUT_EXISTS = 9
INPUT_SPACE = 10
INPUT_HASH = 11

# Pasta de saida (CR-012, README §8.13): base = output_dir/<ambiente>; relativo = pasta do script (forma
# segura de pastas_log.pasta_script), AAAA/MM/DD/HH/MI e ticket_<id>.
_RE_SCRIPT_DIR = re.compile(r"^[a-z0-9-][a-z0-9._-]{0,199}$")
_RE_MINUTE_RELATIVE = re.compile(r"^\d{4}/\d{2}/\d{2}/\d{2}/\d{2}$")
_RE_TICKET = re.compile(r"^ticket_[1-9]\d{0,9}$")
_CHUNK = 64 * 1024
_MAX_OUTPUT_BYTES = 209715200
_MAX_OUTPUT_FILES = 10000
_MTIME_MIN = 315705600  # 1980-01-03 UTC: o zip nao aceita datas anteriores a 1980 em nenhum fuso

# Pasta de entrada pela tela (CR-020c): cada nivel da subpasta e o nome do arquivo.
_RE_INPUT_PART = re.compile(r"^[^/\x00-\x1f\x7f]{1,255}$")
_RE_SHA256 = re.compile(r"^[0-9a-f]{64}$")
_INPUT_MAX_DEPTH = 10
_INPUT_MAX_BYTES = 1073741824
_INPUT_MAX_ITEMS = 10000
_INPUT_COUNT_CAP = 100000
INPUT_TMP_PREFIX = ".sss_upload_"

_MAX_SPEC = 1024 * 1024
_ALLOWED_RLIMITS = ("RLIMIT_CORE", "RLIMIT_NOFILE", "RLIMIT_CPU", "RLIMIT_AS", "RLIMIT_FSIZE",
                       "RLIMIT_NPROC", "RLIMIT_DATA", "RLIMIT_STACK")


class Failure(Exception):
    def __init__(self, code, message):
        Exception.__init__(self, message)
        self.code = code


def _error(code, message):
    raise Failure(code, message)


def _integer(text, name, minimum=0, maximum=None):
    if not isinstance(text, str) or not text.isdigit():
        _error(INVALID_USAGE, "%s invalido" % name)
    value = int(text)
    if value < minimum or (maximum is not None and value > maximum):
        _error(INVALID_USAGE, "%s fora da faixa" % name)
    return value


def _base_dir(path, name="base_dir"):
    """exec_work_dir/<usuario> ou output_dir/<ambiente>: absoluta, normalizada, sem link e do proprio usuario
    (CR-008, R-36; CR-012)."""
    if not isinstance(path, str) or not path.startswith("/") or os.path.normpath(path) != path:
        _error(INVALID_USAGE, "%s deve ser absoluta e normalizada" % name)
    if os.path.realpath(path) != path:
        _error(INVALID_USAGE, "%s nao pode ter link simbolico" % name)
    try:
        st = os.lstat(path)
    except OSError:
        _error(INVALID_USAGE, "%s inexistente" % name)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
        _error(INVALID_USAGE, "%s deve ser um diretorio do proprio usuario" % name)
    return path


def _relative_parts(relative):
    """<pasta do script>/AAAA/MM/DD/HH/MI/ticket_<id> com exatamente esse formato (CR-012)."""
    if not isinstance(relative, str):
        _error(INVALID_USAGE, "relativo invalido")
    parts = relative.split("/")
    if len(parts) != 7 or not _RE_SCRIPT_DIR.match(parts[0]) \
            or not _RE_MINUTE_RELATIVE.match("/".join(parts[1:6])) or not _RE_TICKET.match(parts[6]):
        _error(INVALID_USAGE, "relativo fora do formato <script>/AAAA/MM/DD/HH/MI/ticket_<id>")
    return parts


def _own_directory(path):
    """True se caminho e diretorio do proprio usuario (sem seguir link); False se nao existe."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return False
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
        _error(INVALID_USAGE, "item do caminho da saida nao e diretorio do proprio usuario")
    return True


def _output_dir(base, relative, create=False):
    """Pasta de saida (ou de trabalho, CR-019) do ticket, conferida nivel a nivel sem seguir links; criar=True
    cria com 0700.

    Devolve o caminho, ou None se algum nivel nao existir (e criar=False).
    """
    current = _base_dir(base, "base")
    for part in _relative_parts(relative):
        current = os.path.join(current, part)
        if _own_directory(current):
            continue
        if not create:
            return None
        try:
            os.mkdir(current, 0o700)
        except FileExistsError:  # criado por outro caminho entre o lstat e o mkdir: conferido abaixo
            pass
        if not _own_directory(current):
            _error(SYSTEM_ERROR, "pasta de saida nao foi criada")
        os.chmod(current, 0o700)
    return current


def _input_dir(base, relative):
    """Pasta de entrada do script (CR-014, README §8.14): base = input_dir/<ambiente> e relativo = a pasta do
    script, um nivel so. Permanente: criada com 0700 se nao existir, sem seguir link; a existente fica como esta."""
    if not isinstance(relative, str) or not _RE_SCRIPT_DIR.match(relative):
        _error(INVALID_USAGE, "entrada fora do formato <script>")
    current = os.path.join(_base_dir(base, "base"), relative)
    if not _own_directory(current):
        try:
            os.mkdir(current, 0o700)
        except FileExistsError:  # criada por outro ticket entre o lstat e o mkdir: conferida abaixo
            pass
        if not _own_directory(current):
            _error(SYSTEM_ERROR, "pasta de entrada nao foi criada")
    return current


def _ticket_dir(base_dir, ticket_id):
    return os.path.join(base_dir, "ticket_%d" % ticket_id)


# -----------------------------------------------------------------------------
# run
# -----------------------------------------------------------------------------

def _read_spec(input_value):
    raw = input_value.read(_MAX_SPEC + 1)
    if len(raw) > _MAX_SPEC:
        _error(INVALID_USAGE, "especificacao maior que 1 MiB")
    try:
        spec = json.loads(raw.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        _error(INVALID_USAGE, "especificacao nao e JSON valido")
    if not isinstance(spec, dict):
        _error(INVALID_USAGE, "especificacao deve ser um objeto")
    ticket_id = spec.get("ticket_id")
    if not isinstance(ticket_id, int) or isinstance(ticket_id, bool) or ticket_id < 1:
        _error(INVALID_USAGE, "ticket_id invalido")
    argv = spec.get("argv")
    if not isinstance(argv, list) or not argv or not all(isinstance(a, str) for a in argv):
        _error(INVALID_USAGE, "argv invalido")
    if not argv[0].startswith("/"):
        _error(INVALID_USAGE, "argv[0] deve ser absoluto")
    env = spec.get("env") or {}
    if not isinstance(env, dict) or not all(isinstance(k, str) and isinstance(v, str) for k, v in env.items()):
        _error(INVALID_USAGE, "env invalido")
    rlimits = spec.get("rlimits") or {}
    if not isinstance(rlimits, dict):
        _error(INVALID_USAGE, "rlimits invalido")
    limits = {"RLIMIT_CORE": (0, 0), "RLIMIT_NOFILE": (1024, 1024)}
    for name, value in rlimits.items():
        if name not in _ALLOWED_RLIMITS or not isinstance(value, list) or len(value) != 2 \
                or not all(isinstance(x, int) and not isinstance(x, bool) for x in value):
            _error(INVALID_USAGE, "limite de recurso invalido")
        limits[name] = (value[0], value[1])
    output = _ticket_folder(spec, "output", "saida", ticket_id)
    work = _ticket_folder(spec, "work", "pasta de trabalho", ticket_id)
    input_value = spec.get("input")
    if input_value is not None:
        if not isinstance(input_value, dict) or set(input_value) != {"base", "relativo"}:
            _error(INVALID_USAGE, "entrada invalida")
        _base_dir(input_value["base"], "base")
        if not isinstance(input_value["relativo"], str) or not _RE_SCRIPT_DIR.match(input_value["relativo"]):
            _error(INVALID_USAGE, "entrada fora do formato <script>")
    return ticket_id, argv, env, limits, _base_dir(spec.get("base_dir")), output, input_value, work


def _ticket_folder(spec, key, name, ticket_id):
    """{base, relativo} de uma pasta por ticket (saida, CR-012; trabalho, CR-019), ou None se ausente."""
    value = spec.get(key)
    if value is None:
        return None
    if not isinstance(value, dict) or set(value) != {"base", "relativo"}:
        _error(INVALID_USAGE, "%s invalida" % name)
    _base_dir(value["base"], "base")
    if _relative_parts(value["relativo"])[6] != "ticket_%d" % ticket_id:
        _error(INVALID_USAGE, "%s de outro ticket" % name)
    return value


def _run(input_value=None, run=os.execve):
    """Cria <pasta_base>/ticket_<id>/ e tmp/ (0700), entra nela, aplica umask e limites e faz execve."""
    ticket_id, argv, env, limits, dir_base, output, dir_input, work = _read_spec(
        input_value or sys.stdin.buffer)
    dir_value = _ticket_dir(dir_base, ticket_id)
    try:
        # O script nunca le a entrada padrao do helper (a especificacao ja foi consumida).
        null = os.open(os.devnull, os.O_RDONLY)
        os.dup2(null, 0)
        os.close(null)
        os.makedirs(os.path.join(dir_value, "tmp"), mode=0o700, exist_ok=True)
        os.chmod(dir_value, 0o700)
        os.chmod(os.path.join(dir_value, "tmp"), 0o700)
        if output is not None:
            # CR-012: a pasta de saida do ticket, do usuario de execucao, antes do script (README §8.13).
            _output_dir(output["base"], output["relativo"], create=True)
        if dir_input is not None:
            # CR-014: a pasta de entrada do script, permanente, do usuario de execucao (README §8.14).
            _input_dir(dir_input["base"], dir_input["relativo"])
        if work is not None:
            # CR-019: a pasta de trabalho do ticket, do usuario de execucao, que fica depois dele (README §8.15).
            _output_dir(work["base"], work["relativo"], create=True)
        os.chdir(dir_value)
        os.umask(0o077)
        for name, pair in sorted(limits.items()):
            resource.setrlimit(getattr(resource, name), pair)
    except OSError as e:
        _error(SYSTEM_ERROR, "preparo da execucao falhou (%s)" % e.__class__.__name__)
    try:
        run(argv[0], argv, env)
    except OSError as e:
        _error(SYSTEM_ERROR, "execve falhou (%s)" % e.__class__.__name__)
    return 0


# -----------------------------------------------------------------------------
# term / kill
# -----------------------------------------------------------------------------

def _identity(pid):
    """starttime do processo (campo 22 de /proc/<pid>/stat, depois do ultimo ')'); None se ilegivel."""
    try:
        with open("/proc/%d/stat" % pid, "r") as f:
            content = f.read()
        return int(content[content.rindex(")") + 2:].split()[19])
    except (OSError, ValueError, IndexError):  # processo saiu ou /proc ilegivel: identidade desconhecida
        return None


def _signal(pgid, process_start, signal_value):
    if pgid <= 1:
        _error(INVALID_USAGE, "pgid invalido")
    try:
        os.kill(pgid, 0)
        leader_alive = True
    except ProcessLookupError:  # lider ja saiu; os membros do grupo seguem (R-02)
        leader_alive = False
    except PermissionError:
        # O lider do grupo e o sudo, que roda como root: EPERM e o caso normal. A identidade lida em
        # /proc/<pid>/stat (legivel por todos) protege contra PID reciclado (revisao de 2026-10-20).
        leader_alive = True
    if leader_alive:
        identity = _identity(pgid)
        if identity is None or identity != process_start:
            _error(REFUSED, "identidade do lider diverge (PID reciclado)")
    return signal_value


def _term(pgid, process_start):
    signal_value = _signal(pgid, process_start, signal.SIGTERM)
    try:
        os.killpg(pgid, signal_value)
    except ProcessLookupError:  # ESRCH = grupo vazio: sucesso
        return 0
    except PermissionError:  # so o sudo (root) resta no grupo: nada do usuario de execucao a sinalizar
        return 0
    return 0


def _kill(pgid, process_start):
    signal_value = _signal(pgid, process_start, signal.SIGKILL)
    try:
        os.killpg(pgid, signal_value)
    except ProcessLookupError:  # ESRCH = grupo vazio: sucesso
        return 0
    except PermissionError:  # so o sudo (root) resta no grupo: nada do usuario de execucao a sinalizar
        return 0
    return 0


# -----------------------------------------------------------------------------
# limpar / stop-ticket
# -----------------------------------------------------------------------------

def _clean(base_dir, ticket_id):
    """Remove <pasta_base>/ticket_<id>/ sem seguir links simbolicos."""
    dir_value = _ticket_dir(_base_dir(base_dir), ticket_id)
    if not os.path.lexists(dir_value):
        return 0
    if os.path.islink(dir_value) or not os.path.isdir(dir_value):
        _error(INVALID_USAGE, "pasta do ticket nao e um diretorio")
    try:
        shutil.rmtree(dir_value)  # rmtree nao segue links simbolicos internos (remove o proprio link)
    except OSError as e:
        _error(SYSTEM_ERROR, "limpeza falhou (%s)" % e.__class__.__name__)
    return 0


def _stop_ticket(base_dir, ticket_id, kill_grace_s, list_fn=None):
    """SIGTERM e, depois de kill_grace_s, SIGKILL aos processos do proprio usuario cujo cwd esta na pasta do
    ticket (Linux: /proc/<pid>/cwd; outros Unix: pwdx). Sem meio de identificar: codigo 5."""
    dir_value = _ticket_dir(_base_dir(base_dir), ticket_id)
    my_uid = os.geteuid()
    pwdx = [p for p in ("/usr/bin/pwdx", "/bin/pwdx") if os.path.isfile(p)]

    def _na_pasta(cwd):
        cwd = os.path.normpath(cwd)
        return os.path.commonpath([cwd, dir_value]) == dir_value

    def _listar_proc():
        pids = []
        for name in os.listdir("/proc/"):
            if not name.isdigit() or int(name) == os.getpid():
                continue
            try:
                if os.stat("/proc/" + name).st_uid != my_uid:
                    continue
                if _na_pasta(os.readlink("/proc/%s/cwd" % name)):
                    pids.append(int(name))
            except OSError:  # processo saiu durante a varredura
                continue
        return pids

    def _listar_pwdx():
        output = subprocess.run(["/bin/ps", "-U", str(my_uid), "-o", "pid="], stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, universal_newlines=True).stdout
        pids = []
        for pid in (int(x) for x in output.split() if x.isdigit()):
            line = subprocess.run([pwdx[0], str(pid)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                   universal_newlines=True).stdout
            parts = line.split(":", 1)
            if len(parts) == 2 and _na_pasta(parts[1].strip()):
                pids.append(pid)
        return pids

    if list_fn is None:
        if os.path.isdir("/proc/self") and os.path.exists("/proc/self/cwd"):
            list_fn = _listar_proc
        elif pwdx:
            list_fn = _listar_pwdx
        else:
            _error(UNSUPPORTED, "sem /proc/<pid>/cwd nem pwdx nesta plataforma")

    for signal_value in (signal.SIGTERM, signal.SIGKILL):
        pids = list_fn()
        for pid in pids:
            try:
                os.kill(pid, signal_value)
            except ProcessLookupError:  # processo ja saiu
                pass
        if not pids or signal_value == signal.SIGKILL:
            break
        limit = time.monotonic() + kill_grace_s
        while time.monotonic() < limit and list_fn():
            time.sleep(0.1)
    return 0


# -----------------------------------------------------------------------------
# Pasta de saida (CR-012)
# -----------------------------------------------------------------------------

class _CountedOutput(object):
    """Saida padrao sem seek. Ao passar de max_bytes, marca excedeu e descarta o resto: o laco para e o zip
    fecha normalmente (o zipfile da 3.6 nao fecha com um handle de escrita aberto apos erro)."""

    def __init__(self, destination, max_bytes):
        self.destination = destination
        self.max_bytes = max_bytes
        self.written = 0
        self.exceeded = False

    def write(self, date):
        if not self.exceeded:
            self.written += len(date)
            if self.written > self.max_bytes:
                self.exceeded = True
            else:
                self.destination.write(date)
        return len(date)

    def flush(self):
        self.destination.flush()


def _output_files(folder, max_files):
    """[(caminho, nome_relativo)] dos arquivos regulares, sem seguir links; acima do limite: codigo 7."""
    files = []
    for root, dirs, names in os.walk(folder, followlinks=False):
        dirs.sort()
        for name in sorted(names):
            path = os.path.join(root, name)
            try:
                if not stat.S_ISREG(os.lstat(path).st_mode):
                    continue  # link, socket, fifo ou dispositivo: fora do zip
            except OSError:  # o script apagou o arquivo durante a varredura
                continue
            files.append((path, os.path.relpath(path, folder)))
            if len(files) > max_files:
                _error(OUTPUT_TOO_MANY_FILES, "saida acima do limite de arquivos")
    return files


def _pack(base, relative, max_bytes, max_files, destination=None):
    """Zip (ZIP_DEFLATED) da pasta de saida na saida padrao. Vazia: 6; arquivos: 7; bytes: 8."""
    dir_value = _output_dir(base, relative)
    if dir_value is None:
        _error(OUTPUT_EMPTY, "pasta de saida inexistente")
    files = _output_files(dir_value, max_files)
    if not files:
        _error(OUTPUT_EMPTY, "pasta de saida vazia")
    output = _CountedOutput(destination or sys.stdout.buffer, max_bytes)
    try:
        with zipfile.ZipFile(output, "w", zipfile.ZIP_DEFLATED) as z:
            for path, name in files:
                try:
                    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
                except OSError:  # apagado ou trocado por link depois da varredura: fica de fora
                    continue
                with os.fdopen(fd, "rb") as f:
                    st = os.fstat(f.fileno())
                    if not stat.S_ISREG(st.st_mode):
                        continue
                    info = zipfile.ZipInfo(name, time.localtime(max(st.st_mtime, _MTIME_MIN))[:6])
                    info.compress_type = zipfile.ZIP_DEFLATED
                    info.external_attr = 0o600 << 16
                    with z.open(info, "w") as dst:
                        while not output.exceeded:
                            chunk = f.read(_CHUNK)
                            if not chunk:
                                break
                            dst.write(chunk)
                if output.exceeded:
                    break
        output.flush()
    except OSError as e:
        _error(SYSTEM_ERROR, "empacotamento falhou (%s)" % e.__class__.__name__)
    if output.exceeded:
        _error(OUTPUT_TOO_MANY_BYTES, "saida acima do limite de bytes")
    return 0


def _clean_output(base, relative):
    """Remove a pasta de saida do ticket sem seguir links simbolicos (as pastas acima ficam; limpeza manual, README §11.3)."""
    dir_value = _output_dir(base, relative)
    if dir_value is None:
        return 0
    try:
        shutil.rmtree(dir_value)  # rmtree nao segue links simbolicos internos (remove o proprio link)
    except OSError as e:
        _error(SYSTEM_ERROR, "limpeza da saida falhou (%s)" % e.__class__.__name__)
    return 0


# -----------------------------------------------------------------------------
# Entrada
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# put-input / list-input (CR-020c, README §8.14)
# -----------------------------------------------------------------------------

def _input_part(text):
    """Um nivel da subpasta ou o nome do arquivo: sem '/', controle, '.' no inicio nem mais de 255 caracteres."""
    if not isinstance(text, str) or not _RE_INPUT_PART.match(text) or text.startswith("."):
        _error(INVALID_USAGE, "nome ou subpasta fora do formato")
    return text


def _input_folder(base, script, relative, create):
    """Pasta do script e subpastas, conferidas nivel a nivel sem seguir links; create=True cria com 0700."""
    if not isinstance(script, str) or not _RE_SCRIPT_DIR.match(script):
        _error(INVALID_USAGE, "pasta do script fora do formato")
    parts = [] if relative == "-" else relative.split("/")
    if len(parts) > _INPUT_MAX_DEPTH:
        _error(INVALID_USAGE, "subpasta com niveis demais")
    current = _base_dir(base, "base")
    for part in [script] + [_input_part(p) for p in parts]:
        current = os.path.join(current, part)
        if _own_directory(current):
            continue
        if not create:
            return None
        try:
            os.mkdir(current, 0o700)
        except FileExistsError:  # criada por outro caminho entre o lstat e o mkdir: conferida abaixo
            pass
        if not _own_directory(current):
            _error(SYSTEM_ERROR, "pasta de entrada nao foi criada")
    return current


def _put_input(base, script, relative, name, replace, sha256, size, source=None):
    """Grava a entrada padrao em <base>/<script>/<subpasta>/<nome>: temporario O_EXCL no destino, hash e tamanho
    conferidos, publicacao atomica. Sem substituir, um item ja existente (de qualquer tipo) e INPUT_EXISTS."""
    _input_part(name)
    if replace not in ("Y", "N") or not isinstance(sha256, str) or not _RE_SHA256.match(sha256):
        _error(INVALID_USAGE, "substituicao ou hash fora do formato")
    folder = _input_folder(base, script, relative, create=True)
    final = os.path.join(folder, name)
    tmp = os.path.join(folder, "%s%d.tmp" % (INPUT_TMP_PREFIX, os.getpid()))
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except OSError as e:
        _error(SYSTEM_ERROR, "temporario nao foi criado (%s)" % e.__class__.__name__)
    digest, written = hashlib.sha256(), 0
    stream = source or sys.stdin.buffer
    try:
        try:
            while True:
                chunk = stream.read(_CHUNK)
                if not chunk:
                    break
                digest.update(chunk)
                written += len(chunk)
                if written > size:
                    break
                os.write(fd, chunk)
            os.fsync(fd)
        finally:
            os.close(fd)
    except OSError as e:
        os.unlink(tmp)
        if e.errno in (errno.ENOSPC, errno.EDQUOT):
            _error(INPUT_SPACE, "sem espaco na pasta de entrada")
        _error(SYSTEM_ERROR, "gravacao falhou (%s)" % e.__class__.__name__)
    if written != size or digest.hexdigest() != sha256:
        os.unlink(tmp)
        _error(INPUT_HASH, "tamanho ou hash divergente")
    if replace == "N":
        try:
            os.link(tmp, final)
        except FileExistsError:
            os.unlink(tmp)
            _error(INPUT_EXISTS, "o arquivo ja existe")
        os.unlink(tmp)
    else:
        try:
            st = os.lstat(final)
        except FileNotFoundError:
            st = None
        if st is not None and not stat.S_ISREG(st.st_mode):
            os.unlink(tmp)
            _error(INVALID_USAGE, "o destino existe e nao e arquivo regular")
        os.replace(tmp, final)
    sys.stdout.write("gravado=%d\n" % written)
    return 0


def _list_input(base, script, max_items):
    """Retrato JSON da pasta do script: {files: [{path, size, mtime}], count, truncated}, por caminho, sem seguir
    links e sem os temporarios do put-input. Pasta ainda inexistente: vazia."""
    folder = _input_folder(base, script, "-", create=False)
    files, count = [], 0
    pending = [(folder, "")] if folder else []
    while pending and count < _INPUT_COUNT_CAP:
        current, prefix = pending.pop()
        try:
            entries = sorted(os.scandir(current), key=lambda e: e.name)
        except OSError:  # pasta removida ou sem permissao durante a varredura
            continue
        for entry in entries:
            if entry.name.startswith(INPUT_TMP_PREFIX):
                continue
            rel = prefix + entry.name
            if entry.is_dir(follow_symlinks=False):
                pending.append((entry.path, rel + "/"))
            elif entry.is_file(follow_symlinks=False):
                count += 1
                if len(files) < max_items:
                    st = entry.stat(follow_symlinks=False)
                    files.append({"path": rel, "size": st.st_size,
                                  "mtime": datetime.datetime.fromtimestamp(int(st.st_mtime)).strftime("%Y-%m-%d %H:%M:%S")})
    files.sort(key=lambda f: f["path"])
    sys.stdout.write(json.dumps({"files": files, "count": count, "truncated": count > len(files)}) + "\n")
    return 0


def run_main(argv):
    if not argv:
        _error(INVALID_USAGE, "subcomando ausente")
    sub, args = argv[0], argv[1:]
    if sub == "run" and not args:
        return _run()
    if sub in ("term", "kill") and len(args) == 2:
        pgid = _integer(args[0], "pgid", minimum=2)
        start = _integer(args[1], "process_start")
        return _term(pgid, start) if sub == "term" else _kill(pgid, start)
    if sub == "clean" and len(args) == 2:
        return _clean(args[0], _integer(args[1], "ticket_id", minimum=1))
    if sub == "pack" and len(args) == 4:
        return _pack(args[0], args[1], _integer(args[2], "max_bytes", minimum=1, maximum=_MAX_OUTPUT_BYTES),
                          _integer(args[3], "max_arquivos", minimum=1, maximum=_MAX_OUTPUT_FILES))
    if sub == "clean-output" and len(args) == 2:
        return _clean_output(args[0], args[1])
    if sub == "put-input" and len(args) == 7:
        return _put_input(args[0], args[1], args[2], args[3], args[4], args[5],
                          _integer(args[6], "bytes", maximum=_INPUT_MAX_BYTES))
    if sub == "list-input" and len(args) == 3:
        return _list_input(args[0], args[1], _integer(args[2], "max_itens", minimum=1, maximum=_INPUT_MAX_ITEMS))
    if sub == "stop-ticket" and len(args) == 3:
        return _stop_ticket(args[0], _integer(args[1], "ticket_id", minimum=1),
                                _integer(args[2], "kill_grace_s", maximum=300))
    _error(INVALID_USAGE, "uso invalido")


def main():
    try:
        return run_main(sys.argv[1:])
    except Failure as f:
        sys.stderr.write("sss-helper: %s\n" % f)
        return f.code
    except Exception as e:  # noqa: BLE001 - nenhum traceback com dados sai do helper
        sys.stderr.write("sss-helper: erro inesperado (%s)\n" % e.__class__.__name__)
        return SYSTEM_ERROR


if __name__ == "__main__":
    sys.exit(main())
