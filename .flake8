# Lint (CR-022b9, D7): 99 colunas para todo arquivo. Os arquivos de per-file-ignores tem divida
# anterior ao CR-022b9 e ignoram so os codigos que ja violavam. A lista so diminui
# (tests/architecture/test_quality_debt.py): ao limpar um arquivo, apague a linha dele.
# Nunca acrescente arquivo nem codigo. dev/scripts/ fica fora do lint: sao os scripts de negocio que o
# SSS executa (exemplos e scripts do responsavel), nao a aplicacao, e nao vao no pacote.
[flake8]
max-line-length = 99
extend-exclude = dev/scripts
per-file-ignores =
