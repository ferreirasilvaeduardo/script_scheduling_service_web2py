; Modelo do AGENTE so para os testes (CR-032, D4): um config por processo; as pastas saem do name.
[app]
name = agente0001

[oracle]
user = sss_agente
dsn = localhost:2424/servico_homolog
owner = openrisow
table_prefix = tbsss_
driver_mode = thick

[agent]
environments = PRODUCAO,HOMOLOGACAO
max_parallel_jobs = 4
script_base_dir =                 ; vazio: so caminho absoluto
output_dir =                      ; vazio desliga
input_dir =                       ; vazio desliga
script_work_dir =                 ; vazio desliga
env_passthrough = ORACLE_HOME,TNS_ADMIN,NLS_LANG,LD_LIBRARY_PATH
