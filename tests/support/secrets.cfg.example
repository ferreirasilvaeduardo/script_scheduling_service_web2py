; secrets.cfg do NÓ WEB (README §4.1, CR-007 D1b): só [oracle] e [web].
; Dono = usuário do processo, modo 0600. Nunca versione o arquivo real.
[oracle]
password = CHANGE_ME           ; conta Oracle do papel web ([oracle] user)

[web]
cookie_key = CHANGE_ME         ; igual em todos os nós web

; secrets.cfg do AGENTE (outro servidor, outro arquivo): sem [web].
; [oracle]
; password = CHANGE_ME         ; conta Oracle do papel agente
;
; [environment:PRODUCAO]          ; somente os ambientes de [agent] environments
; user = CHANGE_ME
; password = CHANGE_ME
