; config.ini de referencia do SSS (README §12.1; CR-026: config simplificado).
; As linhas ativas sao as que precisam de valor em cada servidor. As comentadas tem o padrao ao lado:
; so descomente para usar outro valor. O SSS nao cria as pastas configuradas (crie antes, DEPLOYMENT §8).

[app]
sss_env = DEV                     ; DEV | HML | PROD

[oracle]
user = sss_web                    ; conta do papel deste no: sss_web no web, sss_agente no agente (README §4.1)
dsn = localhost:2424/servico_homolog
owner = openrisow
table_prefix = tbsss_
driver_mode = thick               ; thick (recomendado) | cx_oracle | auto (padrao: Thin -> Thick -> cx_Oracle) | thin; o Thin exige a biblioteca cryptography, que o projeto nao usa (README §2.3)
; call_timeout_ms = 30000

; [secrets]
; secrets_file = /etc/sss/secrets.cfg   ; padrao: o secrets.cfg da mesma pasta deste config.ini

[agent]
agent_id = srv-linux-prod-01
environments = PRODUCAO,HOMOLOGACAO
work_dir = /portaloptrib/TESHUVA/SSS/DEV/script_scheduling_service/work
max_parallel_jobs = 4
exec_users =                      ; AMBIENTE=usuario do SO por ambiente (README §8.0); obrigatorio fora de DEV, ex.: PRODUCAO=sssprd,HOMOLOGACAO=ssshml
exec_work_dir =                   ; pasta base dos diretorios de trabalho dos scripts (obrigatoria fora de DEV), ex.: /opt/sss/exec
helper_path =                     ; CR-028: helper de execucao (pasta so do root); vazio: ../sss-root/bin/sss-helper ao lado da raiz
script_base_dir =                 ; CR-023: pasta base dos scripts com caminho relativo (README §8.5); vazio: so caminho absoluto
output_dir =                      ; CR-012: pasta de saida dos scripts (README §8.13); vazio desliga
input_dir =                       ; CR-014: pasta de entrada dos scripts (README §8.14); vazio desliga
script_work_dir =                 ; CR-019: pasta de trabalho dos scripts, por ticket (README §8.15); vazio desliga
env_passthrough = ORACLE_HOME,TNS_ADMIN,NLS_LANG,LD_LIBRARY_PATH
; script_timeout_s = 604800
; misfire_policy = RUN_ONCE         ; RUN_ONCE | SKIP
; log_dir_min_free_mb = 1024        ; abaixo disso em log_dir o agente nao reserva tickets (CR-008, R-25)
; output_max_bytes = 20971520       ; limite do zip da saida (1 MiB a 200 MiB)
; output_max_files = 1000           ; limite de arquivos da saida (1 a 10.000)

[logging]
log_dir = /portaloptrib/TESHUVA/SSS/DEV/script_scheduling_service/logs
; level = INFO                      ; DEBUG | INFO | WARN | ERROR
; app_log_max_bytes = 10485760
; max_log_size_bytes = 5242880
; max_local_log_size_bytes = 52428800

[web]
allowed_origins = http://127.0.0.1:18000   ; ex.: https://sss.empresa.local; lista separada por virgula, validada contra Origin/Referer
; trusted_proxies =
; session_idle_timeout_s = 1800
; session_max_hours = 12            ; vida maxima da sessao desde o login (CR-008, E2)
; login_max_attempts = 5
; login_lockout_s = 900
; input_upload_max_bytes = 52428800 ; CR-020d: maior arquivo enviado pela tela de Entrada (1 MiB a 200 MiB)
