.bkp/

# Byte-compiled / cache files
*.pyc
__pycache__/

# SSS instance configuration (only .example is tracked)
/instance/config.ini
/instance/web.env

# Pastas de execucao do DEV (logs, trabalho do agente, entrada, saida e pasta de trabalho dos scripts)
/logs/
/work/
/input/
/output/
/script_work/
/dist/

# Logs and secrets
*.log
secrets.cfg
.env
*.env
# Launchers locais de desenvolvimento (podem conter dados da maquina do desenvolvedor)
bin/sss-web-*_v*.sh
dev/others/notas/sss-web-*_v*.sh
# Sobras do web2py (removido no CR-021f) numa copia antiga: parameters_<porta>.py guarda o hash da
# senha do painel dele e nunca pode ir para o git
/parameters_*.py
/httpserver.pid
/cron.master
/welcome.w2p
/gluon/
/applications/

# Pacotes de implantacao gerados (binarios)
/docs/sss_packages/*.tar.gz
/docs/sss_packages/*.sha256
/docs/sss_dev_script_examples/
# Capturas do manual de homologacao: ja ficam dentro do .docx (dev/others/homologation/README.md)
/dev/others/homologation/screens/
# Evidencias reais (2026-10-22): capturas e estado da rodada; o .docx e o results.json sao versionados
/dev/others/homologation/evidence_*/*.png
/dev/others/homologation/evidence_*/state.json
# Senha da homologacao do DEV (~/.sss_homolog_pw): nunca no git, nem copiada para dentro do repositorio
.sss_homolog_pw
