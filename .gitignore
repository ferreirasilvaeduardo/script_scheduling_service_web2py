.bkp/

# Byte-compiled / cache files
*.pyc
__pycache__/

# Somente a aplicacao do SSS fica em applications/
applications/*
!applications/script_scheduling_service/

# SSS instance configuration (only .example is tracked)
applications/script_scheduling_service/instance/config.ini
applications/script_scheduling_service/instance/web.env
applications/script_scheduling_service/logs/
applications/script_scheduling_service/work/

# Logs and secrets
*.log
secrets.cfg
.env
*.env
# Launchers locais de desenvolvimento (podem conter dados da maquina do desenvolvedor)
bin/sss-web-*_v*.sh
# Sobras do web2py (removido no CR-021f) numa copia antiga: parameters_<porta>.py guarda o hash da
# senha do painel dele e nunca pode ir para o git
/parameters_*.py
/httpserver.pid
/cron.master
/welcome.w2p
/gluon/

# Pacotes de implantacao gerados (binarios)
/applications/script_scheduling_service/docs/sss_packages/*.tar.gz
/applications/script_scheduling_service/docs/sss_packages/*.sha256
/applications/script_scheduling_service/docs/sss_dev_script_examples/
# Capturas do manual de homologacao: ja ficam dentro do .docx (dev/homologation/README.md)
applications/script_scheduling_service/dev/homologation/screens/
# Evidencias reais (2026-10-22): capturas e estado da rodada; o .docx e o results.json sao versionados
applications/script_scheduling_service/dev/homologation/evidence_*/*.png
applications/script_scheduling_service/dev/homologation/evidence_*/state.json
applications/script_scheduling_service/output/
applications/script_scheduling_service/input/
applications/script_scheduling_service/script_work/
